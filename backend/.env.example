# Pipeline backend - environment variable template
# Copy this file to .env and fill in real values for local development.
# Do NOT commit .env -- it is already gitignored.

# ---------------------------------------------------------------------------
# Calendly (E10)
# ---------------------------------------------------------------------------
# Primary scheduling URL the agent sends to customers.
# Falls back to https://calendly.com/jills-plumbing/consultation if unset.
CALENDLY_SCHEDULING_URL=https://calendly.com/jills-plumbing/consultation

# Optional. Calendly event-type URI, only required if we wire the
# Calendly v2 event-type-specific APIs (not needed for MVP).
CALENDLY_EVENT_TYPE_URI=

# ---------------------------------------------------------------------------
# CORS (existing)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins. "*" opens to everyone -- fine
# for local development. Tighten to the deployed frontend URL in prod.
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# LLM (optional; only needed if you wire an LLM fallback into triage / quotes)
# ---------------------------------------------------------------------------
# The service modules do not import any LLM SDK directly. The orchestrator
# (E2) is expected to construct a callable client and pass it in via
# `classify_urgency(..., llm_client=...)`.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
